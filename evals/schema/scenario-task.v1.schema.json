{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magistermarketing.com/evals/schema/scenario-task.v1.json",
  "title": "Product scenario task v1",
  "description": "A real multi-turn product chat replayed against a Magister test lane: ordered user turns (the product's own task brief and Continue re-prompt, then typed messages), a scripted responder for approval cards and questions, a stop rule, an outcome check, and the metrics read back from the lane's database after each run. The scenario tier measures correctness, speed and efficiency of one chat before and after a change; the task tier (scenario.v2) measures a single answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "description",
    "origin",
    "fixture",
    "turns",
    "responder",
    "stop",
    "outcome",
    "metrics",
    "experience",
    "tags"
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$" },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "description": "task_brief: the brief the lane's own Gateway renders for the plan item (what Work on sends); continue: what the product's Continue button sends now (the Gateway's continue route, or its dispatch text as a plain message when the task is not in a continuable state); message: the literal text.",
          "enum": ["task_brief", "continue", "message"]
        },
        "text": { "type": "string", "minLength": 1 },
        "when": {
          "description": "always: send it; not_published: skip it once the outcome is already met.",
          "enum": ["always", "not_published"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "message" } } },
          "then": { "required": ["text"] }
        }
      ]
    },
    "reply_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "reply"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "match": {
          "description": "A case-insensitive regular expression tested against the agent's latest reply and any options card it drew.",
          "type": "string",
          "minLength": 1
        },
        "reply": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "origin": {
      "description": "The real chat this scenario reproduces: where it ran and what it cost, so run 0 can be read back from that database.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "chat_session_id", "plan_item_id", "project_id", "model", "user_turns"],
      "properties": {
        "lane": { "type": "string", "minLength": 1 },
        "chat_session_id": { "type": "string", "format": "uuid" },
        "plan_item_id": { "type": "string", "format": "uuid" },
        "project_id": { "type": "string", "format": "uuid" },
        "model": { "type": "string", "minLength": 1 },
        "user_turns": {
          "description": "How many of the chat's user turns run 0 covers (the original report's scope).",
          "type": "integer",
          "minimum": 1
        },
        "note": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["website", "brand", "project_slug", "owner_email", "model", "connections", "plan_item"],
      "properties": {
        "website": { "type": "string", "format": "uri" },
        "brand": { "type": "string", "minLength": 1 },
        "project_slug": { "type": "string", "minLength": 1 },
        "owner_email": { "type": "string", "format": "email" },
        "model": {
          "description": "The model the fixture project runs the chat on (set as the project's admin preference before each repetition), so a run measures the same model as its origin unless a run overrides it.",
          "type": "string",
          "minLength": 1
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "platform", "account"],
            "properties": {
              "service": { "type": "string", "minLength": 1 },
              "platform": { "type": "string", "minLength": 1 },
              "account": { "type": "string", "minLength": 1 }
            }
          }
        },
        "plan_item": {
          "description": "The marketing_plan_items row the runner inserts into the fixture's live plan before each repetition: the task's contract, copied from the origin item. Columns the runner owns (id, plan_id, status, chat_session_id, timestamps) are never listed here.",
          "type": "object",
          "required": ["title", "task_prompt", "task_contract", "required_connections", "channel"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "task_prompt": { "type": "string", "minLength": 1 },
            "task_contract": { "type": "object" },
            "task_contract_version": { "type": "integer", "minimum": 1 },
            "required_connections": { "type": "array", "items": { "type": "string" } },
            "channel": { "type": "string" },
            "section_key": { "type": "string" },
            "phase": { "type": "string" },
            "aarrr_stage": { "type": "string" },
            "priority_score": { "type": "number" },
            "effort": { "type": "string" },
            "confidence": { "type": "string" },
            "expected_impact": { "type": "string" },
            "owner_kind": { "type": "string" },
            "workflow_slug": { "type": ["string", "null"] },
            "evidence_refs": { "type": "object" },
            "description": { "type": ["string", "null"] },
            "due_in_days": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    },
    "responder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approve_approvals", "replies", "default_reply", "max_replies"],
      "properties": {
        "approve_approvals": {
          "description": "Allow every pending approval card the agent raises for the fixture project during the run.",
          "type": "boolean"
        },
        "replies": { "type": "array", "items": { "$ref": "#/$defs/reply_rule" } },
        "default_reply": { "type": "string", "minLength": 1 },
        "max_replies": {
          "description": "Scripted replies allowed after the scenario's own turns are spent.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_seconds", "settle_quiet_seconds"],
      "properties": {
        "budget_seconds": { "type": "integer", "minimum": 60 },
        "settle_quiet_seconds": {
          "description": "How long the session must show no queued or running agent turn before the runner acts on its state (approval continuations and plan dispatches queue the next turn a few seconds after the last one ends).",
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "requires_media"],
      "properties": {
        "kind": { "enum": ["social_post_published"] },
        "platform": { "type": "string", "minLength": 1 },
        "requires_media": { "type": "boolean" }
      }
    },
    "metrics": {
      "description": "The metric ids the report prints, in order; every id is one evals.runner.scenario_metrics computes.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "experience": {
      "description": "The rubric judge for how the chat felt (asked once, showed a preview, explained tracking). status stub: the criteria are recorded with every run and not yet judged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "criteria"],
      "properties": {
        "status": { "enum": ["stub", "judged"] },
        "rubric": { "type": "string" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "check"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "check": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
