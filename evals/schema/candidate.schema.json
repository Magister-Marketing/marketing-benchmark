{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magistermarketing.com/evals/schema/candidate.v1.json",
  "title": "Agent evaluation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "model",
    "effort",
    "verbosity",
    "temperature_policy",
    "max_output_tokens",
    "cost_ceiling_usd_per_attempt"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$" },
    "description": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "effort": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", "xhigh", "max", null]
    },
    "verbosity": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "temperature_policy": { "const": "omit" },
    "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 128000 },
    "cost_ceiling_usd_per_attempt": { "type": "number", "exclusiveMinimum": 0 }
  }
}
