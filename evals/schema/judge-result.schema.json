{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magistermarketing.com/evals/schema/judge-result.v1.json",
  "title": "Blinded pairwise judge result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "winner",
    "dimension_decisions",
    "overall_rationale"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pair_id": { "type": "string", "pattern": "^pair-[a-f0-9]{20}$" },
    "winner": { "enum": ["A", "B", "tie"] },
    "dimension_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "winner", "evidence"],
        "properties": {
          "dimension_id": { "type": "string" },
          "winner": { "enum": ["A", "B", "tie"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "overall_rationale": { "type": "string", "minLength": 1 }
  }
}
