{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magistermarketing.com/evals/schema/treatment-declaration.json",
  "title": "Agent-system treatment declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "baseline", "treatment", "intended_differences"],
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "runtime", "prompt_layer", "skills", "ui", "integrations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"},
        "label": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "prompt_layer": {"type": "string", "minLength": 1},
        "skills": {"type": "string", "minLength": 1},
        "ui": {"type": "string", "minLength": 1},
        "integrations": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"},
    "baseline": {"$ref": "#/$defs/system"},
    "treatment": {"$ref": "#/$defs/system"},
    "intended_differences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
