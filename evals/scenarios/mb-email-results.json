{
  "schema_version": 1,
  "id": "mb-email-results",
  "title": "How the last email campaigns did",
  "version": 1,
  "description": "Campaign results from the connected email platform, and a recommendation that follows from them.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": [
      {
        "service": "klaviyo",
        "platform": "klaviyo",
        "account": "the emulated Klaviyo account (make lane-connect-all)"
      }
    ]
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "How did our last three email campaigns do? Give me the open rate and click rate for each, and tell me which one we should repeat.",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": false,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Use your best judgement and go ahead.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 480,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "read_the_campaigns",
        "type": "tool_called",
        "tools": [
          "read_analytics_snapshots",
          "read_analytics_breakdown",
          "query_metric",
          "fetch_integration_data",
          "integration_read",
          "get_analytics_view",
          "get_ad_analytics",
          "list_ad_campaigns",
          "get_social_analytics",
          "read_asset",
          "describe_analytics_chart",
          "read",
          "exec"
        ],
        "why": "Nothing was read from the email platform."
      },
      {
        "id": "figures_from_the_data",
        "type": "grounded",
        "sources": [
          {
            "tools": [
              "read_analytics_snapshots",
              "read_analytics_breakdown",
              "query_metric",
              "fetch_integration_data",
              "integration_read",
              "get_analytics_view",
              "get_ad_analytics",
              "list_ad_campaigns",
              "get_social_analytics",
              "read_asset",
              "describe_analytics_chart"
            ]
          },
          {
            "tools": [
              "read"
            ],
            "args": {
              "*": "(^|[\\s/'\"])data/[a-z0-9_]+/|audits/|['\"]data['\"]"
            }
          },
          {
            "tools": [
              "exec"
            ]
          }
        ],
        "min": 2,
        "why": "The answer has to come from the connected data, not from memory."
      },
      {
        "id": "did_not_say_not_connected",
        "type": "reply",
        "pattern": "(is|are|was|were)(n.t| not) connected|not (yet )?connected|needs? to be connected|connect (your|the) [a-z ]{0,30}(account|property|store)",
        "scope": "all",
        "present": false,
        "why": "The account is connected; telling the person to connect it sends them in a circle."
      },
      {
        "id": "no_approval_card",
        "type": "approval",
        "min": 0,
        "max": 0,
        "why": "A question about data never needs the person's approval."
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": [
      {
        "id": "recommendation_follows",
        "check": "The campaign to repeat is the one the stated rates favour."
      }
    ]
  },
  "tags": [
    "magister-benchmark",
    "read",
    "email"
  ]
}
