{
  "schema_version": 1,
  "id": "mb-plan-add-task",
  "title": "A task is added to the plan",
  "version": 1,
  "description": "The person hands over a piece of work for the plan. One plan task exists afterwards, added through the plan tools.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": []
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "Add this to our plan: refresh the hero section of the cold brew landing page ({nonce}), due by the end of the month.",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": false,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Use your best judgement and go ahead.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 480,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "added_through_the_plan",
        "type": "tool_called",
        "tools": [
          "create_plan_item"
        ],
        "args": {
          "*": "hero"
        },
        "max": 1,
        "why": "The task was not added through the plan, or was added twice."
      },
      {
        "id": "task_is_in_the_plan",
        "type": "state",
        "rows": "plan_items",
        "where": {
          "title": "hero|{nonce}"
        },
        "min": 1,
        "max": 1,
        "why": "The plan does not hold the task."
      },
      {
        "id": "no_approval_card",
        "type": "approval",
        "min": 0,
        "max": 0,
        "why": "A question about data never needs the person's approval."
      }
    ],
    "state": [
      {
        "name": "plan_items",
        "table": "marketing_plan_items",
        "select": "id,title,status,created_at",
        "scope": "plan",
        "cleanup": "delete"
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": []
  },
  "tags": [
    "magister-benchmark",
    "plan"
  ]
}
