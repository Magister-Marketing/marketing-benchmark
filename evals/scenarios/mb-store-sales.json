{
  "schema_version": 1,
  "id": "mb-store-sales",
  "title": "Best-selling products from the connected store",
  "version": 1,
  "description": "A question only the store's own orders answer.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": [
      {
        "service": "shopify",
        "platform": "shopify",
        "account": "the emulated store (make lane-connect-all)"
      }
    ]
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "What were our three best-selling products by revenue in the last 30 days, and how many orders did we get in total?",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": false,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Use your best judgement and go ahead.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 480,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "figures_from_the_data",
        "type": "grounded",
        "sources": [
          {
            "tools": [
              "read_analytics_snapshots",
              "read_analytics_breakdown",
              "query_metric",
              "fetch_integration_data",
              "integration_read",
              "get_analytics_view",
              "get_ad_analytics",
              "list_ad_campaigns",
              "get_social_analytics",
              "read_asset",
              "describe_analytics_chart"
            ]
          },
          {
            "tools": [
              "read",
              "exec"
            ],
            "args": {
              "*": "(^|[\\s/'\"])data/[a-z0-9_]+/|audits/|['\"]data['\"]"
            }
          },
          {
            "tools": [
              "exec"
            ],
            "derived": true
          }
        ],
        "min": 2,
        "why": "The answer has to come from the connected data, not from memory."
      },
      {
        "id": "did_not_say_not_connected",
        "type": "reply",
        "pattern": "(shopify|store)(?:(?!\\bis connected\\b)[^.!?\\n(]){0,60}((is|are|was)(n.t| not) connected|not (yet |currently )?connected|needs? to be connected)|connect (your |the |a )?(shopify|store)",
        "scope": "all",
        "present": false,
        "why": "The account is connected; telling the person to connect it sends them in a circle."
      },
      {
        "id": "no_approval_card",
        "type": "approval",
        "min": 0,
        "max": 0,
        "why": "A question about data never needs the person's approval."
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": [
      {
        "id": "three_products",
        "check": "Three products are named, each with its revenue, and the order total."
      }
    ]
  },
  "tags": [
    "magister-benchmark",
    "read",
    "shopify"
  ]
}
