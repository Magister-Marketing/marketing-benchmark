{
  "schema_version": 1,
  "id": "mb-traffic-chart",
  "title": "Sessions by channel as a chart",
  "version": 1,
  "description": "The person asks for a chart. In web chat, measured data across items is drawn as a chart, not typed as a list.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": [
      {
        "service": "google_analytics",
        "platform": "google_analytics",
        "account": "the emulated GA4 property (make lane-connect-all)"
      }
    ]
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "Show me sessions by channel for the last four weeks as a chart.",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": false,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Use your best judgement and go ahead.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 480,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "drew_a_chart",
        "type": "rendered",
        "components": [
          "BarChart",
          "LineChart",
          "AreaChart",
          "PieChart",
          "StackedBarChart",
          "DonutChart"
        ],
        "why": "Asked for a chart, the person got text."
      },
      {
        "id": "bars_are_the_data",
        "type": "grounded",
        "sources": [
          {
            "tools": [
              "read_analytics_snapshots",
              "read_analytics_breakdown",
              "query_metric",
              "fetch_integration_data",
              "integration_read",
              "get_analytics_view",
              "get_ad_analytics",
              "list_ad_campaigns",
              "get_social_analytics",
              "read_asset",
              "describe_analytics_chart"
            ]
          },
          {
            "tools": [
              "read",
              "exec"
            ],
            "args": {
              "*": "(^|[\\s/'\"])data/[a-z0-9_]+/|audits/|['\"]data['\"]"
            }
          },
          {
            "tools": [
              "exec"
            ],
            "derived": true
          }
        ],
        "scope": "rendered",
        "min": 3,
        "why": "The chart's values are not the figures the agent read."
      },
      {
        "id": "did_not_say_not_connected",
        "type": "reply",
        "pattern": "(google analytics|ga4|analytics)[^.!?\\n]{0,60}((is|are|was)(n.t| not) connected|not (yet |currently )?connected|needs? to be connected)|connect (your |the |a )?(google analytics|ga4|analytics)",
        "scope": "all",
        "present": false,
        "why": "The account is connected; telling the person to connect it sends them in a circle."
      },
      {
        "id": "no_approval_card",
        "type": "approval",
        "min": 0,
        "max": 0,
        "why": "A question about data never needs the person's approval."
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": [
      {
        "id": "chart_matches_data",
        "check": "Every bar or point in the chart equals a row the agent read."
      }
    ]
  },
  "tags": [
    "magister-benchmark",
    "read",
    "ga4",
    "chart"
  ]
}
