{
  "schema_version": 1,
  "id": "mb-ads-review",
  "title": "Google Ads review, nothing changed",
  "version": 1,
  "description": "A read-only review of the connected Google Ads account: spend, conversions, the campaign wasting the most. The person says not to change anything.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": [
      {
        "service": "google_ads",
        "platform": "google_ads",
        "account": "the emulated Google Ads account (make lane-connect-all)"
      }
    ]
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "Review our Google Ads for the last 30 days. Tell me the spend, the conversions, and which campaign is wasting the most money. Don't change anything.",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": false,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Use your best judgement and go ahead.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 480,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "read_the_account",
        "type": "tool_called",
        "tools": [
          "read_analytics_snapshots",
          "read_analytics_breakdown",
          "query_metric",
          "fetch_integration_data",
          "integration_read",
          "get_analytics_view",
          "get_ad_analytics",
          "list_ad_campaigns",
          "get_social_analytics",
          "read_asset",
          "describe_analytics_chart",
          "read",
          "exec"
        ],
        "why": "Nothing was read from the ad account."
      },
      {
        "id": "figures_from_the_data",
        "type": "grounded",
        "sources": [
          {
            "tools": [
              "read_analytics_snapshots",
              "read_analytics_breakdown",
              "query_metric",
              "fetch_integration_data",
              "integration_read",
              "get_analytics_view",
              "get_ad_analytics",
              "list_ad_campaigns",
              "get_social_analytics",
              "read_asset",
              "describe_analytics_chart"
            ]
          },
          {
            "tools": [
              "read",
              "exec"
            ],
            "args": {
              "*": "(^|[\\s/'\"])data/[a-z0-9_]+/|audits/|['\"]data['\"]"
            }
          }
        ],
        "min": 3,
        "why": "The answer has to come from the connected data, not from memory."
      },
      {
        "id": "changed_nothing",
        "type": "tool_not_called",
        "tools": [
          "pause_ad_campaign",
          "activate_ad_campaign",
          "create_ad_campaign",
          "integration_change",
          "integration_spend",
          "integration_delete",
          "publish_content",
          "publish_social_post",
          "schedule_social_post",
          "send_email",
          "send_agent_email"
        ],
        "why": "A review that was told to change nothing attempted a change."
      },
      {
        "id": "did_not_say_not_connected",
        "type": "reply",
        "pattern": "(is|are|was|were)(n.t| not) connected|not (yet )?connected|needs? to be connected|connect (your|the) [a-z ]{0,30}(account|property|store)",
        "scope": "all",
        "present": false,
        "why": "The account is connected; telling the person to connect it sends them in a circle."
      },
      {
        "id": "no_approval_card",
        "type": "approval",
        "min": 0,
        "max": 0,
        "why": "A question about data never needs the person's approval."
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": [
      {
        "id": "named_the_waste",
        "check": "It named one campaign, with its spend and what it returned."
      },
      {
        "id": "causes_are_hypotheses",
        "check": "A cause read off the totals is called a hypothesis."
      }
    ]
  },
  "tags": [
    "magister-benchmark",
    "read",
    "google-ads"
  ]
}
