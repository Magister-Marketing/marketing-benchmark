{
  "schema_version": 1,
  "id": "mb-product-seo-update",
  "title": "A store page change, approved, lands on the store",
  "version": 1,
  "description": "A change to the live store goes through an approval card carrying the exact change. The person approves; the change runs once.",
  "fixture": {
    "website": "https://emulated-store.test/",
    "brand": "Emulated Store",
    "project_slug": "magister-bench",
    "owner_email": "bench-emu@magistermarketing.com",
    "model": "openai/gpt-6.2-sol",
    "connections": [
      {
        "service": "shopify",
        "platform": "shopify",
        "account": "the emulated store (make lane-connect-all)"
      }
    ]
  },
  "turns": [
    {
      "id": "t1",
      "kind": "message",
      "text": "Update the SEO description of our Classic Tee product page so it says the tee is 100% organic cotton. Keep it under 155 characters.",
      "when": "always"
    }
  ],
  "responder": {
    "approve_approvals": true,
    "replies": [],
    "reply_when": "question",
    "default_reply": "Yes, go ahead with that description.",
    "max_replies": 1
  },
  "stop": {
    "budget_seconds": 600,
    "settle_quiet_seconds": 15
  },
  "outcome": {
    "kind": "product_checks",
    "checks": [
      {
        "id": "card_carried_the_change",
        "type": "approval",
        "match": {
          "*": "organic cotton"
        },
        "min": 1,
        "why": "No approval card carried the new description."
      },
      {
        "id": "change_ran_once",
        "type": "approval",
        "match": {
          "*": "organic cotton"
        },
        "decision": "allowed",
        "executed": true,
        "min": 1,
        "max": 1,
        "why": "The approved change did not run, or ran more than once."
      },
      {
        "id": "said_it_is_done",
        "type": "reply",
        "pattern": "\\b(updated|saved|changed|live|done)\\b",
        "scope": "final",
        "why": "After the change, the person was not told it landed."
      }
    ]
  },
  "metrics": [
    "passed",
    "outcome_summary",
    "wall_seconds_total",
    "user_turns",
    "llm_calls",
    "tool_calls",
    "cost_usd",
    "approvals_requested",
    "approvals_allowed"
  ],
  "experience": {
    "status": "stub",
    "criteria": []
  },
  "tags": [
    "magister-benchmark",
    "approval",
    "shopify"
  ]
}
