        "relative_path": "deliverables/ga4-diagnosis.md",
        "media_type": "text/markdown",
        "min_bytes": 250
      }
    ],
    "ui_contracts": []
  },
  "scorers": ["tool-contract@1", "ga4-grounding@1"],
  "rubric": "evals/rubrics/analysis.json",
  "timeout_seconds": 480,
  "max_model_calls": 14,
  "tags": ["ga4", "rate-limit", "retry", "draft-only"]
}
