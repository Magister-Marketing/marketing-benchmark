{
  "schema_version": 2,
  "id": "ga4-rate-limit-recovery",
  "suite": "integrations-ga4",
  "task_family": "analysis",
  "version": 1,
  "description": "Recover from one retryable GA4 rate-limit response without inventing data.",
  "prompt": "Read the analytics skill. Diagnose last week's conversion decline with the connected synthetic GA4 tools. If a read returns a retryable rate limit, follow its bounded retry guidance and continue; do not fabricate results or retry indefinitely. Save the grounded diagnosis and next test to deliverables/ga4-diagnosis.md.",
  "fixtures": ["evals/fixtures/public/brands/northstar-ops"],
  "environment": {
    "plugin": "replay-mcp",
    "fixture": "ga4-conversion-drop-v1",
